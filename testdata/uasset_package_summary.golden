// readCustomVersion reads one CustomVersion.
func readCustomVersion(r *Reader, label string) uasset.CustomVersion {
	var out uasset.CustomVersion
	out.Key = r.ReadGuid(label + ".Key")
	out.Version = r.ReadInt32(label + ".Version")
	return out
}

// readGuidCustomVersion reads one CustomVersion.
func readGuidCustomVersion(r *Reader, label string) uasset.CustomVersion {
	var out uasset.CustomVersion
	out.Key = r.ReadGuid(label + ".Key")
	out.Version = r.ReadInt32(label + ".Version")
