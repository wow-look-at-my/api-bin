<?xml version="1.1" encoding="UTF-8"?>
<api-bin>
	<go package="main" params="r *Reader, version uint32" model="uasset.">
		<import path="github.com/wow-look-at-my/uasset/uasset"/>
	</go>

	<type name="u8" read="r.ReadUint8({label})"/>
	<type name="i32" read="r.ReadInt32({label})"/>
	<type name="u32" read="r.ReadUint32({label})"/>
	<type name="i64" read="r.ReadInt64({label})"/>

	<!-- EVersion: Initial is 1, AddedCookedIndex is 2 (ObjectResource.h:553-560). -->
	<flag name="cooked-index" test="version &gt;= 2"/>

	<!-- One FObjectDataResource of the cooked data resource table. -->
	<struct name="FObjectDataResource" func="readDataResource" label="DataResource">
		<field name="Flags" type="u32"/>
		<field name="CookedIndex" type="u8" if="cooked-index"/>
		<field name="SerialOffset" type="i64"/>
		<field name="DuplicateSerialOffset" type="i64"/>
		<field name="SerialSize" type="i64"/>
		<field name="RawSize" type="i64"/>
		<field name="OuterIndex" type="i32"/>
		<field name="LegacyBulkDataFlags" type="u32"/>
	</struct>
</api-bin>
