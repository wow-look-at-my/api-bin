	<enum name="EEdGraphPinDirection" func="pinDirectionName" go="uint8" unknown="&lt;direction_%d&gt;">
		<value n="0" name="Input"/>
		<value n="1" name="Output"/>
	</enum>

	<enum name="EPinContainerType" func="containerTypeName" go="uint8" unknown="&lt;container_%d&gt;">
		<value n="0" name="None"/>
		<value n="1" name="Array"/>
		<value n="2" name="Set"/>
